{
  "name": "apex-agent-cli",
  "version": "0.17.0",
  "description": "APEX CLI: collaborative coding agents, saved context and an Obsidian-compatible local vault",
  "type": "module",
  "bin": {
    "apex": "bin/apex.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "cli",
    "server",
    "README.md",
    "LICENSE",
    "VALIDATION.md",
    "NOTICE",
    "licenses",
    "obsidian-plugin",
    "COLLABORATION.md",
    "marketplace",
    "remote-ui",
    "EXTENSIONS.md",
    "ACCOUNTS.md",
    "FREE_MODELS.md",
    "EFFICIENCY.md",
    "ONBOARDING.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "PUBLISHING.md",
    "WORKFLOWS.md",
    "MAINTAINER_CLINICS.md",
    "evaluations",
    "SPONSORSHIP.md",
    "EVALUATIONS.md",
    "VAULT_GUIDE.md",
    "ROADMAP_STATUS.md",
    "GROUP_CHAT.md",
    "EXPERIMENTS.md",
    "PROJECT_CONTRACTS.md",
    "ATTENTION.md",
    "EVOLUTION.md",
    "ISOLATION.md",
    "CREDENTIAL_STORAGE.md",
    "COLLAB_PRESENCE.md",
    "MCP_POLICIES.md"
  ],
  "scripts": {
    "start": "node bin/apex.js",
    "test": "node --test tests/*.test.js",
    "verify:collaboration": "node scripts/two-person-workflow.mjs",
    "build:plugin": "node scripts/build-vault-plugin.mjs",
    "verify:terminal": "node scripts/verify-setup-terminal.mjs",
    "test:ci": "node --test --test-concurrency=2 tests/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "yaml": "2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@playwright/mcp": "0.0.83",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustB3Tr/apex-cli-private.git"
  },
  "homepage": "https://github.com/JustB3Tr/apex-cli-private#readme",
  "bugs": {
    "url": "https://github.com/JustB3Tr/apex-cli-private/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "apex",
    "cli",
    "coding-agent",
    "mcp",
    "collaboration",
    "obsidian"
  ]
}
